# Copy this file to .env and set values locally. Never commit .env.
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
COHERE_TIMEOUT_SECONDS=20
COHERE_MAX_OUTPUT_TOKENS=512
COHERE_MAX_RETRIES=1
COHERE_EMBED_MODEL=embed-v5.0-fast
COHERE_EMBED_BATCH_SIZE=96

# Set a rotated server-side PostgreSQL URL only in the ignored .env file.
AI_DATABASE_URL=
AI_DB_CONNECT_TIMEOUT_SECONDS=10
# Dedicated non-owner writer for the explicit ingestion command only.
AI_INGEST_DATABASE_URL=

# Internal service only. Generate a unique random value of at least 32 characters.
AI_INTERNAL_TOKEN=
# Use text until the reviewed evaluation chooses a different retrieval strategy.
AI_RETRIEVAL_STRATEGY=text
# Required only if AI_RETRIEVAL_STRATEGY=hybrid; must match the active KB generation.
AI_EMBED_CONFIG_HASH=
