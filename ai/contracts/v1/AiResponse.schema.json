{
  "$defs": {
    "ChartAxis": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Field",
          "type": "string"
        },
        "kind": {
          "enum": [
            "categorical",
            "numeric",
            "temporal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "field",
        "label",
        "kind"
      ],
      "title": "ChartAxis",
      "type": "object"
    },
    "ChartSpec": {
      "additionalProperties": false,
      "properties": {
        "chart_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Chart Id",
          "type": "string"
        },
        "data_ref": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9:_-]{0,299}$",
          "title": "Data Ref",
          "type": "string"
        },
        "dataset_ref_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Ref Ids",
          "type": "array"
        },
        "filters": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Filters",
          "type": "object"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "enum": [
            "bar",
            "line",
            "scatter",
            "histogram",
            "box",
            "heatmap"
          ],
          "title": "Type",
          "type": "string"
        },
        "x": {
          "$ref": "#/$defs/ChartAxis"
        },
        "y": {
          "$ref": "#/$defs/ChartAxis"
        }
      },
      "required": [
        "chart_id",
        "type",
        "title",
        "data_ref",
        "x",
        "y",
        "dataset_ref_ids"
      ],
      "title": "ChartSpec",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "properties": {
        "database_dataset_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database Dataset Id"
        },
        "nasa_psi_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Nasa Psi Url",
          "type": "string"
        },
        "psi_code": {
          "pattern": "^PSI-[0-9]+$",
          "title": "Psi Code",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Ref Id",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "ref_id",
        "psi_code",
        "relative_path",
        "sha256",
        "nasa_psi_url"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "DocumentEvidence": {
      "additionalProperties": false,
      "properties": {
        "chunk_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chunk Sha256",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "evidence_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "const": "document",
          "default": "document",
          "title": "Kind",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "document_sha256",
        "chunk_sha256",
        "page_number",
        "source_url"
      ],
      "title": "DocumentEvidence",
      "type": "object"
    },
    "ResponseMetrics": {
      "additionalProperties": false,
      "properties": {
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "title": "ResponseMetrics",
      "type": "object"
    },
    "ScientificDatum": {
      "additionalProperties": false,
      "properties": {
        "column_ordinal": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Ordinal"
        },
        "dataset_ref_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Dataset Ref Id",
          "type": "string"
        },
        "datum_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Datum Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "measurement",
            "derived"
          ],
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "sample_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Count"
        },
        "source_record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record"
        },
        "unit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "validation_status": {
          "const": "validated",
          "title": "Validation Status",
          "type": "string"
        },
        "value": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "variable_code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Variable Code",
          "type": "string"
        }
      },
      "required": [
        "datum_id",
        "dataset_ref_id",
        "variable_code",
        "value",
        "unit",
        "validation_status",
        "kind"
      ],
      "title": "ScientificDatum",
      "type": "object"
    },
    "ScientificEvidence": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "$ref": "#/$defs/DatasetRef"
        },
        "datum": {
          "$ref": "#/$defs/ScientificDatum"
        },
        "evidence_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "const": "scientific",
          "default": "scientific",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "dataset",
        "datum"
      ],
      "title": "ScientificEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Answer",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "discriminator": {
          "mapping": {
            "document": "#/$defs/DocumentEvidence",
            "scientific": "#/$defs/ScientificEvidence"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DocumentEvidence"
          },
          {
            "$ref": "#/$defs/ScientificEvidence"
          }
        ]
      },
      "title": "Evidence",
      "type": "array"
    },
    "intent": {
      "enum": [
        "scientific_analysis",
        "document_question",
        "combined",
        "unknown"
      ],
      "title": "Intent",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/ResponseMetrics"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "supported",
        "partially_supported",
        "insufficient_evidence",
        "invalid_request",
        "upstream_unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "visualizations": {
      "items": {
        "$ref": "#/$defs/ChartSpec"
      },
      "title": "Visualizations",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "status",
    "intent",
    "answer"
  ],
  "title": "AiResponse",
  "type": "object"
}
