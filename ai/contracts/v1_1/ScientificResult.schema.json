{
  "$defs": {
    "CellRef": {
      "additionalProperties": false,
      "properties": {
        "column_ordinal": {
          "minimum": 1,
          "title": "Column Ordinal",
          "type": "integer"
        },
        "dataset_ref_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Dataset Ref Id",
          "type": "string"
        },
        "source_record": {
          "minimum": 1,
          "title": "Source Record",
          "type": "integer"
        }
      },
      "required": [
        "dataset_ref_id",
        "source_record",
        "column_ordinal"
      ],
      "title": "CellRef",
      "type": "object"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "properties": {
        "database_dataset_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database Dataset Id"
        },
        "psi_code": {
          "pattern": "^PSI-[0-9]+$",
          "title": "Psi Code",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Ref Id",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Title",
          "type": "string"
        },
        "source_url": {
          "maxLength": 500,
          "pattern": "^https://[^\\s]+$",
          "title": "Source Url",
          "type": "string"
        },
        "table_name": {
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Table Name",
          "type": "string"
        }
      },
      "required": [
        "ref_id",
        "psi_code",
        "table_name",
        "relative_path",
        "sha256",
        "source_id",
        "source_title",
        "source_url"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "DerivedDatum": {
      "additionalProperties": false,
      "properties": {
        "applied_filters": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Applied Filters",
          "type": "object"
        },
        "cohort": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cohort"
        },
        "dataset_ref_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Dataset Ref Ids",
          "type": "array"
        },
        "datum_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Datum Id",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "input_cells": {
          "items": {
            "$ref": "#/$defs/CellRef"
          },
          "title": "Input Cells",
          "type": "array"
        },
        "input_set_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Set Sha256"
        },
        "input_set_version": {
          "anyOf": [
            {
              "const": "scientific-input-set-c14n-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Set Version"
        },
        "kind": {
          "const": "derived",
          "default": "derived",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "method_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Method Version",
          "type": "string"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "unit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "validation_status": {
          "const": "validated",
          "default": "validated",
          "title": "Validation Status",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "variable_code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Variable Code",
          "type": "string"
        }
      },
      "required": [
        "datum_id",
        "dataset_ref_ids",
        "variable_code",
        "value",
        "unit",
        "method",
        "method_version",
        "sample_count"
      ],
      "title": "DerivedDatum",
      "type": "object"
    },
    "MeasurementDatum": {
      "additionalProperties": false,
      "properties": {
        "anomalies": {
          "items": {
            "type": "string"
          },
          "title": "Anomalies",
          "type": "array"
        },
        "column_ordinal": {
          "minimum": 1,
          "title": "Column Ordinal",
          "type": "integer"
        },
        "dataset_ref_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Dataset Ref Id",
          "type": "string"
        },
        "datum_id": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "title": "Datum Id",
          "type": "string"
        },
        "interpretation_status": {
          "const": "exact",
          "default": "exact",
          "title": "Interpretation Status",
          "type": "string"
        },
        "kind": {
          "const": "measurement",
          "default": "measurement",
          "title": "Kind",
          "type": "string"
        },
        "raw_value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "source_header": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Header",
          "type": "string"
        },
        "source_record": {
          "minimum": 1,
          "title": "Source Record",
          "type": "integer"
        },
        "trial_code": {
          "pattern": "^PSI-[0-9]+:[a-zA-Z0-9_-]+:[1-9][0-9]*$",
          "title": "Trial Code",
          "type": "string"
        },
        "unit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "validation_status": {
          "const": "validated",
          "default": "validated",
          "title": "Validation Status",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "variable_code": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Variable Code",
          "type": "string"
        }
      },
      "required": [
        "datum_id",
        "dataset_ref_id",
        "trial_code",
        "source_record",
        "column_ordinal",
        "source_header",
        "variable_code",
        "value",
        "raw_value",
        "unit"
      ],
      "title": "MeasurementDatum",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "enum": [
        "bass-ii",
        "flex",
        "flame-design",
        "cfi-g",
        "spice"
      ],
      "title": "Analysis Id",
      "type": "string"
    },
    "canonicalization_version": {
      "const": "scientific-result-c14n-v1",
      "title": "Canonicalization Version",
      "type": "string"
    },
    "data": {
      "items": {
        "discriminator": {
          "mapping": {
            "derived": "#/$defs/DerivedDatum",
            "measurement": "#/$defs/MeasurementDatum"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MeasurementDatum"
          },
          {
            "$ref": "#/$defs/DerivedDatum"
          }
        ]
      },
      "title": "Data",
      "type": "array"
    },
    "data_version": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Data Version",
      "type": "string"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/DatasetRef"
      },
      "title": "Datasets",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "result_id": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "enum": [
        "parquet",
        "postgres"
      ],
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "insufficient_evidence"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "canonicalization_version",
    "result_id",
    "data_version",
    "analysis_id",
    "status",
    "source",
    "datasets",
    "data"
  ],
  "title": "ScientificResult",
  "type": "object"
}
